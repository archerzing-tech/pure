{
  "name": "pure",
  "version": "2.0.2-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "bun run src/cli.ts",
    "cli:build": "bun run scripts/build-cli.ts",
    "dev": "vite",
    "gui": "bun run tauri dev",
    "gui:build": "bun run tauri build",
    "toolchain:check": "bash scripts/check-toolchain.sh",
    "toolchain:setup": "bash scripts/setup-mac-toolchain.sh",
    "test": "bun test",
    "verify:plan-restore": "bun run scripts/verify-plan-restore.ts --scenario=restore",
    "verify:plan-session": "bun run scripts/verify-plan-restore.ts --scenario=session",
    "verify:plan-progress": "bun run scripts/verify-plan-restore.ts --scenario=progress",
    "verify:gates": "bun run scripts/verify-plan-restore.ts --scenario=gates",
    "verify:auto-continue": "bun run scripts/verify-auto-continue.ts",
    "verify:auto-continue-abort": "bun run scripts/verify-auto-continue.ts --scenario=abort",
    "eval:baseline": "bun run scripts/run-evals.ts",
    "e2e:apikey": "bun run scripts/e2e-settings-apikey.ts",
    "typecheck": "bun run --no-run tsc --noEmit",
    "build": "bun run typecheck && npx vite build && bun run cli:build",
    "build:cli": "bun run cli:build",
    "sign:mac": "bash scripts/sign-app.sh",
    "build:gui:mac": "bash scripts/build-gui-mac.sh",
    "preview": "npx vite preview"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.1.0",
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "openai": "^7.1.0",
    "plantuml-encoder": "^1.4.0",
    "vite": "^8.1.5"
  }
}
